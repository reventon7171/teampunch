# PostgreSQL connection string.
# Local:   postgresql://USER:PASSWORD@localhost:5432/punchcard?schema=public
# Hosted (Neon/Supabase free tier also works):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/punchcard?schema=public"

# Long random secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"

# How long an access token stays valid.
JWT_EXPIRES_IN="12h"

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (mobile dev client / Expo Go).
CORS_ORIGIN="*"

# Seed data — default admin account. CHANGE THE PASSWORD after first login in production.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin1234"

# --- Google Drive photo sync (optional) ---
# Leave all three blank to skip Drive entirely — check-in/check-out/leave photos still work
# fine, just stay on local disk only. See README.md section "Google Drive photo sync" for the
# full step-by-step walkthrough (Google Cloud Console + running `npm run drive:auth`).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Obtained by running `npm run drive:auth` once, after the two values above are set.
GOOGLE_OAUTH_REFRESH_TOKEN=""
