# PostgreSQL connection string.
# Local:   postgresql://USER:PASSWORD@localhost:5432/punchcard?schema=public
# Hosted (Neon/Supabase free tier also works):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/punchcard?schema=public"

# Long random secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"

# How long an access token stays valid.
JWT_EXPIRES_IN="12h"

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (mobile dev client / Expo Go).
CORS_ORIGIN="*"

# Seed data — default organization + admin account. CHANGE THE PASSWORD after first login.
SEED_ORG_NAME="ร้านตัวอย่าง"
SEED_ORG_SLUG="demo"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin1234"

# --- Photo storage: Cloudflare R2 (optional in dev, REQUIRED in production) ---
# Leave all four blank to fall back to local disk (fine for `npm run dev`, but local disk is
# wiped on every redeploy on most hosts — NOT durable, admins would lose photo history). See
# README.md section "Photo storage (Cloudflare R2)" for the full step-by-step walkthrough.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# --- Email: Resend (optional in dev, REQUIRED for admin "forgot password" to actually send) ---
# Leave blank to fall back to logging the email to the console instead of sending it. See
# HANDOFF.md section 9.1 for the full walkthrough (account signup, sandbox-vs-verified-domain).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TeamPunch <onboarding@resend.dev>"
