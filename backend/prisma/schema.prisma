generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per business that signs up (a "tenant"). slug is the short code a business's
// admins/employees type at login (e.g. "somchai-cafe") since usernames are only unique
// within an organization, not globally, across a public multi-tenant install.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Payroll cadence — every business pays on its own schedule, so this was pulled out of
  // hardcoded "1st/16th of the month" (bxs-bar's rule) into an org-level setting. Only the
  // fields relevant to the chosen payFrequency are used; the rest sit at their default.
  payFrequency       String @default("SEMI_MONTHLY") // DAILY | WEEKLY | MONTHLY | SEMI_MONTHLY
  weeklyPayWeekday   Int    @default(5) // 0 (Sun) - 6 (Sat) — payday when payFrequency=WEEKLY
  monthlyPayDay      Int    @default(1) // 1-28 — payday (of the following month) when payFrequency=MONTHLY
  semiMonthlyPayDay1 Int    @default(16) // payday for the 1st-15th period when payFrequency=SEMI_MONTHLY
  semiMonthlyPayDay2 Int    @default(1) // payday (of the following month) for the 16th-end period

  admins             Admin[]
  employees          Employee[]
  attendance         Attendance[]
  leaves             Leave[]
  holidays           Holiday[]
  advances           Advance[]
  commissions        Commission[]
  dutyAssignments    DutyAssignment[]
  dutyTaskOptions    DutyTaskOption[]
  dutyScheduleRules  DutyScheduleRule[]
  dayOffSwaps        DayOffSwapRequest[]
  workplaceLocation  WorkplaceLocation?
}

model Admin {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  username       String
  passwordHash   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, username])
}

model Employee {
  id           String   @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name         String
  position     String?
  baseSalary   Decimal  @db.Decimal(12, 2)
  workStart    String // "HH:MM" 24h
  workEnd      String // "HH:MM" 24h, may be <= workStart for overnight shifts
  daysOff      Int[] // weekday numbers 0 (Sun) - 6 (Sat)
  hireDate     String? // "YYYY-MM-DD" — nullable only for rows created before this field existed;
  // required going forward at the application layer (createEmployeeSchema)
  username     String
  passwordHash String
  active       Boolean  @default(true)
  dutyRotationEnabled Boolean @default(false) // opts this employee into the random daily cleaning-duty rotation at check-in (previously hardcoded to position === "เสิร์ฟ")
  socialSecurityRate Decimal @default(0) @db.Decimal(5, 2) // % deducted from this employee's gross pay each period (0 = no deduction). Percent of that period's pay, not a flat monthly figure.
  wageType     String   @default("MONTHLY") // MONTHLY (flat salary, prorated by hire date) | DAILY_WAGE (paid baseSalary/30 for each day actually checked in that period, nothing for days not worked — no late/leave deduction layered on top since there's no base salary to deduct from)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance        Attendance[]
  leaves            Leave[]
  advances          Advance[]
  commissions       Commission[]
  dutyAssignments   DutyAssignment[]
  dutyScheduleRules DutyScheduleRule[]
  dayOffSwaps       DayOffSwapRequest[]

  @@unique([organizationId, username])
  @@index([organizationId, active])
}

model Attendance {
  id      String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date String // "YYYY-MM-DD", local calendar date of the shift's check-in

  checkInTime      String? // "HH:MM"
  checkInLat       Decimal? @db.Decimal(9, 6)
  checkInLng       Decimal? @db.Decimal(9, 6)
  checkInPhotoPath String?

  checkOutTime      String? // "HH:MM"
  checkOutLat       Decimal? @db.Decimal(9, 6)
  checkOutLng       Decimal? @db.Decimal(9, 6)
  checkOutPhotoPath String?

  lateMinutes     Int     @default(0)
  deductionHours  Int     @default(0)
  deductionAmount Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

enum LeaveType {
  SICK
  PERSONAL
  VACATION
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Leave {
  id         String      @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String // "YYYY-MM-DD"
  type       LeaveType
  reason     String?
  photoPath  String?
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([employeeId, date])
  @@index([organizationId, status])
}

// Employee-requested swap of their weekly day off, for one specific week only — e.g. work
// this Monday (their normal day off) instead and take Wednesday off. Once APPROVED,
// originalOffDate becomes a normal working day and swappedToDate becomes the day off
// (payroll.ts isDayOff() reads this; the employee's recurring Employee.daysOff is untouched).
model DayOffSwapRequest {
  id             String      @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  originalOffDate String // "YYYY-MM-DD"
  swappedToDate  String // "YYYY-MM-DD"
  reason         String?
  status         LeaveStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([employeeId])
  @@index([organizationId, status])
}

model Holiday {
  id        String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD"
  name      String
  createdAt DateTime @default(now())

  @@unique([organizationId, date])
}

model Advance {
  id         String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodKey  String // "YYYY-MM-H1" | "YYYY-MM-H2"
  amount     Decimal  @default(0) @db.Decimal(12, 2)
  note       String?
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, periodKey])
}

model Commission {
  id         String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  yearMonth  String // "YYYY-MM"
  amount     Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, yearMonth])
}

// Admin-managed list of possible daily cleaning duties (used to used to be a fixed 3-value
// enum — now editable from the app so admins can add more without a code change/deploy).
// Deactivating (not deleting) keeps history intact for duties already assigned.
model DutyTaskOption {
  id        String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  assignments   DutyAssignment[]
  scheduleRules DutyScheduleRule[]

  @@unique([organizationId, label])
}

// Admin-set recurring rule: "every Monday, employee X gets task Y" — checked at check-in
// BEFORE falling back to the random pool, so an employee can be fully random, fully fixed
// (a rule for every weekday they work), or a mix (rules for some weekdays, random on others).
model DutyScheduleRule {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekday        Int // 0 (Sun) - 6 (Sat)
  taskId         String
  taskOption     DutyTaskOption @relation(fields: [taskId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([employeeId, weekday])
}

// Daily cleaning-duty rotation, assigned at check-in time to any employee with
// dutyRotationEnabled=true (previously hardcoded to position === "เสิร์ฟ").
// One assignment per employee per day (assigned once, randomly, and never reassigned that day)
// so admins have a permanent record of who was responsible for what on any given date.
model DutyAssignment {
  id         String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String // "YYYY-MM-DD"
  taskId     String
  taskOption DutyTaskOption @relation(fields: [taskId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

// One row per organization — the workplace's GPS coordinate + allowed check-in radius.
// When enabled=false or the row doesn't exist yet, check-in/check-out skip the location check
// entirely (unconfigured on a fresh install rather than silently blocking everyone).
model WorkplaceLocation {
  id             String   @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lat            Decimal  @db.Decimal(9, 6)
  lng            Decimal  @db.Decimal(9, 6)
  radiusMeters   Int      @default(150)
  enabled        Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}
