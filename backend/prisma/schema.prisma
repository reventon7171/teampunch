generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per business that signs up (a "tenant"). slug is the short code a business's
// admins/employees type at login (e.g. "somchai-cafe") since usernames are only unique
// within an organization, not globally, across a public multi-tenant install.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Payroll cadence — every business pays on its own schedule, so this was pulled out of
  // hardcoded "1st/16th of the month" (bxs-bar's rule) into an org-level setting. Only the
  // fields relevant to the chosen payFrequency are used; the rest sit at their default.
  // For SEMI_MONTHLY, the two paydays are cutoff dates (order doesn't matter): each period
  // runs from the day after the previous payday through this payday, paid same-day — e.g.
  // paydays 5 & 20 → the period paid the 5th covers the 21st of last month through the 5th,
  // and the period paid the 20th covers the 6th through the 20th.
  payFrequency       String @default("SEMI_MONTHLY") // WEEKLY | MONTHLY | SEMI_MONTHLY
  weeklyPayWeekday   Int    @default(5) // 0 (Sun) - 6 (Sat) — payday when payFrequency=WEEKLY
  monthlyPayDay      Int    @default(1) // 1-28 — payday (of the following month) when payFrequency=MONTHLY
  semiMonthlyPayDay1 Int    @default(16)
  semiMonthlyPayDay2 Int    @default(1)

  // Late-arrival deduction — a flat baht amount the admin sets directly, instead of deriving
  // it from each employee's hourly rate. Both null (the default) means "keep computing it
  // from the employee's hourly rate x hours late" (the original bxs-bar behavior). Setting
  // lateDeductionFirstHour switches every employee in this org to flat amounts: that value
  // for the first late hour (1-60 min), then lateDeductionPerExtraHour (or the same value,
  // if that one is left null) for each additional hour late beyond the first.
  lateDeductionFirstHour    Decimal? @db.Decimal(12, 2)
  lateDeductionPerExtraHour Decimal? @db.Decimal(12, 2)

  // Daily-wage employees are already simply unpaid for a day they don't work — this is an
  // OPTIONAL extra flat penalty on top of that, off by default. Ignored for MONTHLY employees.
  dailyWageDeductAbsence          Boolean  @default(false)
  dailyWageAbsenceDeductionAmount Decimal? @db.Decimal(12, 2)

  // Single flat multiplier applied to an employee's own hourly rate for every APPROVED
  // overtime hour, org-wide — deliberately not split into separate workday/day-off/holiday
  // rates like Thai labor law technically allows (1.5x / 3x / 2x): that's the HumanSoft-style
  // approach, judged too complex for the SME-focused v1 here. Default 1.5 matches the legal
  // minimum for regular-workday OT.
  otRateMultiplier Decimal @default(1.5) @db.Decimal(4, 2)

  // Billing — scaffolding only, not enforced anywhere yet (no paywall, no payment gateway
  // wired up). isLifetimeFree marks orgs that get to skip billing forever: every org that
  // existed before this system was added was grandfathered in via migration, and early
  // friends-and-family orgs can be marked the same way by hand in the database.
  plan               String   @default("free") // free | paid (no other tiers yet)
  subscriptionStatus String   @default("active") // active | past_due | canceled — unused until a gateway exists
  // Defaults to true while the app is still only going out to friends pre-launch — nobody
  // should hit a paywall before billing actually exists. Flip this default to false once
  // real billing is ready to launch and new signups should start on a real plan.
  isLifetimeFree     Boolean  @default(true)

  admins             Admin[]
  employees          Employee[]
  attendance         Attendance[]
  leaves             Leave[]
  holidays           Holiday[]
  advances           Advance[]
  commissions        Commission[]
  dayOffSwaps        DayOffSwapRequest[]
  workplaceLocation  WorkplaceLocation?
  shifts             Shift[]
  overtimeRequests   OvertimeRequest[]
}

// A named work-time preset (e.g. "กะเช้า" 08:00-17:00) an org can offer so employees whose
// hours rotate don't need an admin to edit their record every time — they just pick a shift
// themselves (see Employee.shiftId). Capped at 3 per org, enforced in the route layer.
model Shift {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  startTime      String // "HH:MM"
  endTime        String // "HH:MM", may be <= startTime for overnight shifts
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employees Employee[]

  @@index([organizationId])
}

model Admin {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  username       String
  passwordHash   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, username])
}

model Employee {
  id           String   @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name         String
  position     String?
  baseSalary   Decimal  @db.Decimal(12, 2)
  workStart    String // "HH:MM" 24h
  workEnd      String // "HH:MM" 24h, may be <= workStart for overnight shifts
  daysOff      Int[] // weekday numbers 0 (Sun) - 6 (Sat)
  hireDate     String? // "YYYY-MM-DD" — nullable only for rows created before this field existed;
  // required going forward at the application layer (createEmployeeSchema)
  username     String
  passwordHash String
  active       Boolean  @default(true)
  socialSecurityRate Decimal @default(0) @db.Decimal(5, 2) // % deducted from this employee's gross pay each period (0 = no deduction). Percent of that period's pay, not a flat monthly figure.
  wageType     String   @default("MONTHLY") // MONTHLY (flat salary, prorated by hire date) | DAILY_WAGE (paid baseSalary/30 for each day actually checked in that period, nothing for days not worked — no late/leave deduction layered on top since there's no base salary to deduct from)
  // Optional link to one of the org's Shift presets. workStart/workEnd stay the source of
  // truth actually used everywhere (payroll, attendance, late calc) — picking a shift just
  // copies its times into those fields, whether an admin does it or the employee switches
  // themself. Null means "custom hours, not tied to a preset shift".
  shiftId      String?
  shift        Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance        Attendance[]
  leaves            Leave[]
  advances          Advance[]
  commissions       Commission[]
  dayOffSwaps       DayOffSwapRequest[]
  overtimeRequests  OvertimeRequest[]

  @@unique([organizationId, username])
  @@index([organizationId, active])
}

model Attendance {
  id      String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date String // "YYYY-MM-DD", local calendar date of the shift's check-in

  checkInTime      String? // "HH:MM"
  checkInLat       Decimal? @db.Decimal(9, 6)
  checkInLng       Decimal? @db.Decimal(9, 6)
  checkInPhotoPath String?

  checkOutTime      String? // "HH:MM"
  checkOutLat       Decimal? @db.Decimal(9, 6)
  checkOutLng       Decimal? @db.Decimal(9, 6)
  checkOutPhotoPath String?

  lateMinutes     Int     @default(0)
  deductionHours  Int     @default(0)
  deductionAmount Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

enum LeaveType {
  SICK
  PERSONAL
  VACATION
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Leave {
  id         String      @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String // "YYYY-MM-DD"
  type       LeaveType
  reason     String?
  photoPath  String?
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([employeeId, date])
  @@index([organizationId, status])
}

// Employee-requested overtime, for a single date/time range. hours is computed server-side
// from startTime/endTime at request time and stored (not recomputed later) so an admin
// editing settings afterward can't retroactively change an already-submitted request's
// duration. Only APPROVED requests within a pay period count toward payroll (see
// computePayroll's otRecords param) — paid at Organization.otRateMultiplier x hourlyRate,
// one flat rate for the whole org regardless of workday/holiday (see Organization comment).
model OvertimeRequest {
  id             String      @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           String // "YYYY-MM-DD"
  startTime      String // "HH:MM"
  endTime        String // "HH:MM", may be <= startTime for OT crossing midnight
  hours          Decimal     @db.Decimal(5, 2)
  reason         String?
  status         LeaveStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([employeeId, date])
  @@index([organizationId, status])
}

// Employee-requested swap of their weekly day off, for one specific week only — e.g. work
// this Monday (their normal day off) instead and take Wednesday off. Once APPROVED,
// originalOffDate becomes a normal working day and swappedToDate becomes the day off
// (payroll.ts isDayOff() reads this; the employee's recurring Employee.daysOff is untouched).
model DayOffSwapRequest {
  id             String      @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  originalOffDate String // "YYYY-MM-DD"
  swappedToDate  String // "YYYY-MM-DD"
  reason         String?
  status         LeaveStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([employeeId])
  @@index([organizationId, status])
}

model Holiday {
  id        String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD"
  name      String
  createdAt DateTime @default(now())

  @@unique([organizationId, date])
}

model Advance {
  id         String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodKey  String // "YYYY-MM-H1" | "YYYY-MM-H2"
  amount     Decimal  @default(0) @db.Decimal(12, 2)
  note       String?
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, periodKey])
}

model Commission {
  id         String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  yearMonth  String // "YYYY-MM"
  amount     Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, yearMonth])
}

// One row per organization — the workplace's GPS coordinate + allowed check-in radius.
// When enabled=false or the row doesn't exist yet, check-in/check-out skip the location check
// entirely (unconfigured on a fresh install rather than silently blocking everyone).
model WorkplaceLocation {
  id             String   @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lat            Decimal  @db.Decimal(9, 6)
  lng            Decimal  @db.Decimal(9, 6)
  radiusMeters   Int      @default(150)
  enabled        Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}
